# Copia este archivo como .env y completa con tus datos reales de cPanel
# En cPanel > Setup Node.js App, estas variables se cargan en la sección
# "Environment Variables" de la aplicación (NO subas el .env real a un repo público).

# --- Base de datos MySQL (misma instancia usada por TestLink/Mantis) ---
DB_HOST=localhost
DB_USER=usuario_cpanel_dbuser
DB_PASSWORD=clave_super_segura
DB_NAME=usuario_cpanel_retailqa
DB_PORT=3306

# --- Sesión ---
SESSION_SECRET=cambia_esto_por_un_valor_aleatorio_largo

# --- Servidor ---
# cPanel "Setup Node.js App" asigna el puerto automáticamente vía la variable PORT.
PORT=3000
